{
  "name": "homepilot",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=api",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=api",
    "prisma:push": "npm run prisma:push --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^10.0.4"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  }
}
